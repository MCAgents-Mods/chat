{
  "schemaVersion": 1,
  "id": "mcagents",
  "version": "${version}",
  "name": "MCAgentsClient",
  "description": "A client-side AI assistant for Minecraft. Chat with an LLM agent using your own OpenRouter key, with Knowledge Packs kept on your machine and retrieved by embedding similarity.",
  "authors": [
    "MCAgents"
  ],
  "contact": {
    "homepage": "https://github.com/MCAgents-Mods/chat",
    "sources": "https://github.com/MCAgents-Mods/chat",
    "issues": "https://github.com/MCAgents-Mods/chat/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.mcagentsmods.chat.fabric.MCAgentsClientMod"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabricLoader}",
    "minecraft": "~${minecraft}",
    "java": ">=25",
    "fabric-api": "*",
    "mcagents_core": ">=${coreVersion}",
    "mcagents_agents": ">=${agentsVersion}"
  }
}
